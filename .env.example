# --- Database ---
# Local dev (default): SQLite file. No setup required.
# DATABASE_URL="file:./dev.db"
# Production (Vercel + Postgres): switch prisma/schema.prisma provider to "postgresql"
# and set a Postgres connection string, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/govbidwriter?sslmode=require"
DATABASE_URL="file:./dev.db"

# --- App ---
# Canonical URL used for SEO metadata, sitemap, and absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI provider (Fable 5 via Anthropic API) ---
# Leave empty to run in mock mode: all AI features return realistic deterministic
# sample output so the full app works with zero keys.
FABLE_API_KEY=

# --- Stripe billing (optional) ---
# Leave empty to run billing in mock mode: the pricing page works and "upgrading"
# flips the subscription plan in the local database without charging anything.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Price ID for the Pro plan (e.g. price_123). Required only with real Stripe keys.
STRIPE_PRO_PRICE_ID=

# --- SAM.gov (optional, future opportunity search) ---
SAM_GOV_API_KEY=

# --- Email (optional, Resend) ---
RESEND_API_KEY=

# --- Auth ---
# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A dev fallback is used if empty (NOT safe for production).
AUTH_SECRET=
