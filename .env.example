# --- Database ---
# Production (default): PostgreSQL (Neon/Vercel Postgres/Supabase).
DATABASE_URL="postgresql://user:password@host:5432/govbidwriter?sslmode=require"
# Local SQLite alternative: switch prisma/schema.prisma provider to "sqlite" and use:
# DATABASE_URL="file:./dev.db"

# --- App ---
# Canonical URL used for SEO metadata, sitemap, emails, and absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI provider (DeepSeek) ---
# Leave empty to run in mock mode: all AI features return realistic deterministic
# sample output so the full app works with zero keys.
# Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional overrides:
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Cost-estimation rates (USD per million tokens) used in usage logs:
# AI_COST_INPUT_PER_MTOK=0.28
# AI_COST_OUTPUT_PER_MTOK=0.42

# --- Email (Resend) ---
# Leave empty to run email in mock mode: nothing is sent; every "send" is
# logged to the console and the EmailLog table with status "mocked".
RESEND_API_KEY=
# Sender address. The default onboarding@resend.dev only delivers to the
# Resend account owner — use a verified-domain sender for real users:
# EMAIL_FROM="GovBidWriter <hello@yourdomain.com>"
EMAIL_FROM=
# Receives admin notifications (new signups). Optional.
ADMIN_EMAIL=
# Protects GET /api/cron/process-emails (sequences + deadline reminders).
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# --- Stripe billing (optional) ---
# Leave empty to run billing in mock mode: the pricing page works and "upgrading"
# flips the subscription plan in the database without charging anything.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Price ID for the Pro plan (e.g. price_123). Required only with real Stripe keys.
STRIPE_PRO_PRICE_ID=
# Mock upgrades are always allowed outside production. In PRODUCTION without
# Stripe keys, the billing page shows "setup mode" unless you explicitly set:
# ALLOW_MOCK_BILLING=true

# --- Analytics (PostHog) ---
# Server-side capture (fire-and-forget via fetch):
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Client-side capture (posthog-js, App Router provider):
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- SAM.gov (optional, future opportunity search) ---
SAM_GOV_API_KEY=

# --- Auth ---
# Secret used to sign session cookies and unsubscribe links. REQUIRED in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
